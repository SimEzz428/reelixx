# Copy to backend/.env and fill in.

# Optional. Enables AI scripts, gpt-image-1 visuals and TTS voiceover.
OPENAI_API_KEY=
# 1 = never call OpenAI (free renders only), 0 = allow AI when a key is set.
REELIXX_FREE_MODE=1
# low | medium | high — gpt-image-1 quality (cost scales with quality).
REELIXX_IMAGE_QUALITY=medium

# Defaults to a local SQLite file.
# DATABASE_URL=postgresql://reelixx:reelixx@localhost:5432/reelixx

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex, e.g. for Vercel preview URLs: https://reelixx-.*\.vercel\.app
# CORS_ORIGIN_REGEX=

# Optional S3 storage for rendered videos (local ./app/exports otherwise).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=reelixx-storage
